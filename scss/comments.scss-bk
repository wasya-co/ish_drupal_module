
/* comments */


#edit-comment-body-0-format {
  display: none;
}
#edit-comment-body-0-format-help {
  display: none;
}
.form-item-comment-body-0-format {
  display: none;
}

article.comment {
  .content {
    display: flex;
    align-items: center;

    ul.links {
      margin-bottom: 0;
    }
  }
}


.comment-wrapper {
  article {
    border-left: 2px solid var(--text-color, gray);
    padding-left: 1em;
    margin-bottom: 1em;
  }
  input[data-drupal-selector='edit-preview'] {
    display: none;
  }
  h2.comment-form__title { // "Add new comment"
    display: none;
  }
}

section.field--type-comment {
  margin: 1em;
}
@media screen and (min-width: 768px) { /* desktop */
  section.field--type-comment {
    margin: 1em 5em;
  }
}
