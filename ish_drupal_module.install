  }
  $full_display->setComponent('field_vote_up_down', [
    'label' => 'hidden',
    'settings' => [
      'vote_up_down_formatter_type' => 'thumbs',
    ],
    'type' => 'vote_up_down_formatter_type',
    'weight' => -10,
  ]);
  $full_display->save();


  if (!FieldConfig::loadByName('node', 'object3d', 'field_image_thumb')) {
    FieldConfig::create([
      'bundle' => 'object3d',
      'entity_type' => 'node',
      'field_name' => 'field_image_thumb',
      'label' => 'Image Thumb',
      'required' => FALSE,
      'settings' => [
        'alt_field' => TRUE,
        'alt_field_required' => FALSE,
      ],
    ])->save();
  }
  $form_display->setComponent('field_image_thumb', [
    'type' => 'file_generic',
    'weight' => 25,
    'settings' => [
      // 'alt_field' => TRUE,
      // 'alt_field_required' => FALSE,
    ],
  ]);
  $form_display->save();
  $full_display->setComponent('field_image_thumb', [
    'label' => 'hidden',
    'weight' => -10,
  ]);
