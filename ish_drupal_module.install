/*
 * Slide content type.
**/
function ish_drupal_module_update_9023() {
  if (!NodeType::load('slide')) {
    NodeType::create([
      'type' => 'slide',
      'name' => 'Slide',
      'description' => 'Slide',
      'new_revision' => FALSE,
      'preview_mode' => DRUPAL_OPTIONAL,
      'display_submitted' => FALSE,
    ])->save();
  }

  $form_display = EntityFormDisplay::load('node.slide.default');
  if (!$form_display) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'slide',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  $display = EntityViewDisplay::load('node.slide.full');
  if (!$display) {
    $display = EntityViewDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'slide',
      'mode' => 'full',
      'status' => TRUE,
    ]);
  }
  /* not needed for Slide */
  // $display->setThirdPartySetting('layout_builder', 'enabled', TRUE);
  // $display->setThirdPartySetting('layout_builder', 'allow_custom', TRUE);
  // $display->save();

  /* body */
  $storage = FieldStorageConfig::loadByName('node', 'body');
  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'type' => 'text_with_summary',
      'cardinality' => 1,
      'settings' => [],
      'translatable' => TRUE,
    ]);
    $storage->save();
  }
  $field = FieldConfig::loadByName('node', 'slide', 'body');
  if (!$field) {
    $field = FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'slide',
      'label' => 'Body',
      'description' => '',
      'required' => FALSE,
      'translatable' => TRUE,
      'settings' => [
        'display_summary' => TRUE,
        'required_summary' => FALSE,
      ],
    ]);
    $field->save();
  }
  $form_display ->setComponent('body', [
    'type' => 'text_textarea_with_summary',
    'weight' => 20,
    'region' => 'content',
    'settings' => [
      'rows' => 9,
      'summary_rows' => 3,
      'placeholder' => '',
      'show_summary' => FALSE,
    ],
  ])->save();
  $display->setComponent('body', [
    'type' => 'text_default',
    'label' => 'hidden',
    'weight' => 20,
    'region' => 'content',
    'settings' => [],
  ])->save();


  /* tags */
  $storage = FieldStorageConfig::loadByName('node', 'field_tags');
  $field = FieldConfig::loadByName('node', 'slide', 'field_tags');
  if (!$field) {
    FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'slide',
      'label' => 'Tags',
      'description' => '',
      'required' => FALSE,
      'settings' => [],
    ])->save();
  }
  $form_display->setComponent('field_tags', [
    // 'type' => 'options_select',
    'type' => 'options_buttons',
    'weight' => 40,
    'region' => 'content',
    'settings' => [],
  ])->save();

  foreach (['image_hero', 'image_thumb'] as $field_name) {
    if (!FieldStorageConfig::loadByName('node', 'field_' . $field_name)) {
      FieldStorageConfig::create([
        'field_name' => 'field_' . $field_name,
        'entity_type' => 'node',
        'type' => 'image',
        'cardinality' => 1,
        'settings' => [
          'uri_scheme' => 'public',
        ],
      ])->save();
    }

    if (!FieldConfig::loadByName('node', 'slide', 'field_' . $field_name)) {
      FieldConfig::create([
        'field_name' => 'field_' . $field_name,
        'entity_type' => 'node',
        'bundle' => 'slide',
        'label' => ucwords(str_replace('_', ' ', $field_name)),
        'required' => FALSE,
        'settings' => [
          'file_extensions' => 'png gif jpg jpeg webp',
          'alt_field' => TRUE,
          'title_field' => FALSE,
        ],
      ])->save();
    }

    $form_display->setComponent('field' . $field_name, [
      'type' => 'image_image',
      'weight' => 10,
      'region' => 'content',
      'settings' => [
        'progress_indicator' => 'throbber',
        'preview_image_style' => 'thumbnail',
      ],
    ])->save();
  }
}
