/*
 * Create tags
**/
function ish_drupal_module_update_9022() {
  $vocabulary = 'tags';
  $tag_name = 'Slidesets.';

  // Don't create it if it already exists.
  $existing = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadByProperties([
      'vid' => $vocabulary,
      'name' => $tag_name,
    ]);

  if (!$existing) {
    $term = Term::create([
      'vid' => $vocabulary,
      'name' => $tag_name,
    ]);
    $term->save();
  }
}

/*
