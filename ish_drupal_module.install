<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;
use Drupal\node\Entity\Node;
use Drupal\node\Entity\NodeType;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\Entity\Vocabulary;
use Symfony\Component\HttpFoundation\RedirectResponse;

use Drupal\ish_drupal_module\Models\YoutubeChannel;

/*
 * for piousbox_com as a magazine
 * adds field_last_polled_at to youtube_channel
**/
function ish_drupal_module_update_9001() {
  $content_type = 'youtube_channel';
  $field_name = 'field_last_polled_at';

  if (!FieldStorageConfig::loadByName('node', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => [
        'max_length' => 255,
      ],
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', $content_type, $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'bundle' => $content_type,
      'label' => $field_name,
      'description' => $field_name,
      'required' => FALSE,
      'settings' => [],
    ])->save();
  }
}

/**
 * Migrate article values from field_tag_contrib to field_tags_contrib.
**/
function ish_drupal_module_update_9002() {
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'article')
    ->execute();

  $nodes = Node::loadMultiple($nids);

  foreach ($nodes as $node) {
    if ($node->hasField('field_tag_contrib') && $node->hasField('field_tags_contrib')) {
      $old_values = $node->get('field_tag_contrib')->getValue();
      $node->set('field_tags_contrib', $old_values);
      $node->set('field_tag_contrib', []);
      $node->save();
    }
  }

  \Drupal::messenger()->addMessage('Migrated field_tag_contrib values to field_tags_contrib.');
}

/*
 * create users for all youtube channels
**/
function ish_drupal_module_update_9003() {
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'youtube_channel')
    ->execute();

  foreach ($nids as $nid) {
    $ch = new YoutubeChannel($nid);
    $ch->afterCreate();
  }
  \Drupal::messenger()->addMessage('created users for all youtube channels');
}


/*
 * create object3d
**/
function ish_drupal_module_update_9004() {
  if (!NodeType::load('object3d')) {
    $type = NodeType::create([
      'type' => 'object3d',
      'name' => 'Object3d',
      'description' => 'object3d',
    ]);
    $type->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'field_width')) {
    FieldStorageConfig::create([
      'field_name' => 'field_width',
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => [
        'max_length' => 10,
      ],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'object3d', 'field_width')) {
    FieldConfig::create([
      'field_name' => 'field_width',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Width',
      'required' => TRUE,
    ])->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'field_height')) {
    FieldStorageConfig::create([
      'field_name' => 'field_height',
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => [
        'max_length' => 10,
      ],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'object3d', 'field_height')) {
    FieldConfig::create([
      'field_name' => 'field_height',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Width',
      'required' => TRUE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'object3d', 'field_vote_up_down')) {
    FieldConfig::create([
      'field_name' => 'field_vote_up_down',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Vote Up Down',
      'required' => FALSE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'object3d', 'field_image_thumb')) {
    FieldConfig::create([
      'field_name' => 'field_image_thumb',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Image Thumb',
      'required' => FALSE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'object3d', 'field_tags_contrib')) {
    FieldConfig::create([
      'field_name' => 'field_tags_contrib',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Tags Contrib',
      'required' => FALSE,
    ])->save();
  }

  if (!Vocabulary::load('tags_issue')) {
    Vocabulary::create([
      'vid' => 'tags_issue',
      'description' => 'Tags Issue',
      'name' => 'Tags Issue',
    ])->save();
  }
  if (!FieldStorageConfig::loadByName('node', 'field_tags_issue')) {
    FieldStorageConfig::create([
      'field_name' => 'field_tags_issue',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => -1,
      'settings' => [
        'target_type' => 'taxonomy_term',
      ],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'object3d', 'field_tags_issue')) {
    FieldConfig::create([
      'field_name' => 'field_tags_issue',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Tags Issue',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [
            'tags_issue' => 'tags_issue',
          ],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
  }
  $form_display = EntityFormDisplay::load('node.object3d.default');
  if ($form_display) {
    $form_display->setComponent('field_tags_issue', [
      'type' => 'options_select',
      'weight' => 15,
      'settings' => [
        'match_operator' => 'CONTAINS',
        'size' => 60,
        'placeholder' => '',
      ],
    ])->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'field_model')) {
    FieldStorageConfig::create([
      'field_name' => 'field_model',
      'entity_type' => 'node',
      'type' => 'file',
      'cardinality' => 1,
      'settings' => [
        'uri_scheme' => 'public',
        'file_extensions' => 'glb obj',
        'max_filesize' => '50 MB',
      ],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'object3d', 'field_model')) {
    FieldConfig::create([
      'field_name' => 'field_model',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Model',
      'required' => TRUE,
      'settings' => [
        'description_field' => TRUE,
      ],
    ])->save();
  }

}

