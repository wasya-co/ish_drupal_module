      'cardinality' => 1,
      'settings' => [
        'uri_scheme' => 'public',
        'file_extensions' => 'glb obj',
        'max_filesize' => '50 MB',
      ],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'object3d', 'field_model')) {
    FieldConfig::create([
      'field_name' => 'field_model',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Model',
      'required' => TRUE,
      'settings' => [
        'description_field' => TRUE,
        'file_extensions' => 'glb obj',
      ],
    ])->save();
  }
  $form_display->setComponent('field_model', [
    'type' => 'file_generic',
    'weight' => 25,
    'settings' => [],
  ]);
  $form_display->save();
  $full_display->setComponent('field_model', [
    'label' => 'hidden',
    'type' => 'file_url_plain',
    'weight' => -10,
  ]);
  $full_display->save();
}

