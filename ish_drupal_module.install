/*
 * for piousbox_com as a magazine
 * adds field_last_polled_at to youtube_channel
**/
function ish_drupal_module_update_9001() {
  $content_type = 'youtube_channel';
  if (!NodeType::load($content_type)) {
    $type = NodeType::create([
      'type' => $content_type,
      'name' => $content_type,
      'description' => $content_type,
      'display_submitted' => TRUE,
    ]);
    $type->save();
  }

  $field_name = 'field_last_polled_at';
  if (!FieldStorageConfig::loadByName('node', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => [
        'max_length' => 20,
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', $content_type, $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'bundle' => $content_type,
      'label' => $field_name,
      'description' => $field_name,
      'required' => FALSE,
      'settings' => [],
    ])->save();
  }
}

/**
 * Migrate article values from field_tag_contrib to field_tags_contrib.
**/
function ish_drupal_module_update_9002() {
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'article')
    ->accessCheck(FALSE)
    ->execute();

  $nodes = Node::loadMultiple($nids);

  foreach ($nodes as $node) {
    if ($node->hasField('field_tag_contrib') && $node->hasField('field_tags_contrib')) {
      $old_values = $node->get('field_tag_contrib')->getValue();
      $node->set('field_tags_contrib', $old_values);
      $node->set('field_tag_contrib', []);
      $node->save();
    }
  }

  \Drupal::messenger()->addMessage('Migrated field_tag_contrib values to field_tags_contrib.');
}

/*
 * create users for all youtube channels
**/
function ish_drupal_module_update_9003() {
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'youtube_channel')
    ->accessCheck(FALSE)
    ->execute();

  foreach ($nids as $nid) {
    $ch = new YoutubeChannel($nid);
    $ch->afterCreate();
  }
  \Drupal::messenger()->addMessage('created users for all youtube channels');
}

/*
 * create object3d
 * 2026-01-24
**/
function ish_drupal_module_update_9004() {
  if (!NodeType::load('object3d')) {
    $type = NodeType::create([
      'type' => 'object3d',
      'name' => 'Object3d',
      'description' => 'object3d',
    ]);
    $type->save();
  }
  $repo = \Drupal::service('entity_display.repository');
  $full_display = $repo->getViewDisplay('node', 'object3d', 'full');
  $form_display = $repo->getFormDisplay('node', 'object3d', 'default');

  if (!FieldStorageConfig::loadByName('node', 'field_width')) {
    FieldStorageConfig::create([
      'field_name' => 'field_width',
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => [
        'max_length' => 10,
      ],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'object3d', 'field_width')) {
    FieldConfig::create([
      'field_name' => 'field_width',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'width',
      'required' => TRUE,
    ])->save();
  }
  $form_display->setComponent('field_width', [
    'type' => 'string_textfield',
    'weight' => 20,
    'settings' => [],
  ]);
  $form_display->save();
  $field = FieldConfig::loadByName('node', 'object3d', 'field_width');
  $field->setDefaultValue([
    [ 'value' => '500px' ],
  ]);
  $field->save();


  if (!FieldStorageConfig::loadByName('node', 'field_height')) {
    FieldStorageConfig::create([
      'field_name' => 'field_height',
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => [
        'max_length' => 10,
      ],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'object3d', 'field_height')) {
    FieldConfig::create([
      'field_name' => 'field_height',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'height',
      'required' => TRUE,
    ])->save();
  }
  $form_display->setComponent('field_height', [
    'type' => 'string_textfield',
    'weight' => 21,
    'settings' => [],
  ]);
  $form_display->save();
  $field = FieldConfig::loadByName('node', 'object3d', 'field_height');
  $field->setDefaultValue([
    [ 'value' => '400px' ],
  ]);
  $field->save();


  if (!FieldConfig::loadByName('node', 'object3d', 'field_vote_up_down')) {
    FieldConfig::create([
      'field_name' => 'field_vote_up_down',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Vote Up Down',
      'required' => FALSE,
