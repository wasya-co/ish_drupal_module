  if (!FieldConfig::loadByName('node', 'object3d', 'field_tags_contrib')) {
    FieldConfig::create([
      'field_name' => 'field_tags_contrib',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Tags Contrib',
      'required' => FALSE,
    ])->save();
  }
  $form_display->setComponent('field_tags_contrib', [
    'type' => 'options_buttons',
    'weight' => 23,
    'settings' => [],
  ]);
  $form_display->save();
  $full_display->setComponent('field_tags_contrib', [
    'label' => 'hidden',
    'weight' => -10,
  ]);
  $full_display->save();


  if (!Vocabulary::load('tags_issue')) {
    Vocabulary::create([
      'vid' => 'tags_issue',
      'description' => 'Tags Issue',
      'name' => 'Tags Issue',
    ])->save();
  }
  if (!FieldStorageConfig::loadByName('node', 'field_tags_issue')) {
    FieldStorageConfig::create([
      'field_name' => 'field_tags_issue',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => -1,
      'settings' => [
        'target_type' => 'taxonomy_term',
      ],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'object3d', 'field_tags_issue')) {
    FieldConfig::create([
      'field_name' => 'field_tags_issue',
      'entity_type' => 'node',
      'bundle' => 'object3d',
      'label' => 'Tags Issue',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [
            'tags_issue' => 'tags_issue',
          ],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
