/**
 * Implements hook_page_attachments().
 */
function ish_drupal_module_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'ish_drupal_module/bootstrap';
  $attachments['#attached']['library'][] = 'ish_drupal_module/styles';
}



