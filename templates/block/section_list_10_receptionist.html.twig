
<div class='receptionist2W'>

  <section class="section-receptionist">
    <div class='slogan'>
      <h1 class="display-1">{{ content.field_subtitle }}</h1>
      <p>&nbsp;</p>
    </div>
    <img class='receptionist' src="https://d15g8hc4183yn4.cloudfront.net/wp-content/uploads/2026/09/07151926/receptionist-2.600x366-tiny.png" alt='receptionist' />
  </section>

  {# <h1>{{ dump( content.field_view_ref.0.contents['#view'] ) }}</h1> #}

  <div class='container card-row'>
    <div class='row'>

      {% set view          = content.field_view_ref.0.contents['#view'] %}
      {% set row_view_mode = view.rowPlugin.options.view_mode|default('default') %}
      {% for row in view.result %}
        {# <h1>{{ dump( row._entity ) }}</h1>  #}
        {% if row._entity %}
          <div class='col-6 col-md-4 col-lg-3'>
            {{ drupal_entity('node', row._entity.id, row_view_mode) }}
          </div>
        {% endif %}
      {% endfor %}

    </div><!-- end row -->
    <div class='row'>

      <div class='col-12 text-right text-end'>
        <a href="{{ content.field_link_url[0]['#context']['value'] }}" class='btn btn-outline-secondary'>{{ content.field_link_text[0]['#context']['value'] }}</a>
      </div>

    </div><!-- end row -->
  </div>
</div><!-- end .receptionist2W -->



