{%
  set classes = [
    'swiper',

    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}
<div{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% block content %}
    <div{{ content_attributes.addClass('content swiper-wrapper width-500px border-yellow ') }}>
      {# {{ dump( content.field_view_ref ) }} #}

      {% set view = content.field_view_ref.0.contents['#view'] %}
      {% for row in view.result %}
        {% if row._entity %}
          <div class='border-red swiper-slide width-100px'>
            {# {{ dump( row._entity ) }} #}
            {{ drupal_entity('node', row._entity.id, 'image_thumb') }}
          </div>
        {% endif %}
      {% endfor %}

    </div>
  {% endblock %}

</div>
