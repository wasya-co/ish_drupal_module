
<style>
  {{ content.field_custom_css[0]['#context']['value'] }}
</style>

{%
  set classes = [
    content.field_class_name[0]['#context']['value'],
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}
<div{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% block content %}
    <div class='section-sliderW'>
      <h1>{{ content.field_subtitle }}</h1>

      <div{{ content_attributes.addClass('content swiper one-per-page no-autoplay fixed-container ') }}>
        <div class='swiper-wrapper'>

          {% set view          = content.field_view_ref.0.contents['#view'] %}
          {% set row_view_mode = view.rowPlugin.options.view_mode|default('default') %}
          {% for row in view.result %}
            {% if row._entity %}
              <div class=' swiper-slide width-200px d-flex justify-content-center align-items-center '>
                {# {{ dump( row._entity ) }} #}
                {{ drupal_entity('node', row._entity.id, row_view_mode) }}
              </div>
            {% endif %}
          {% endfor %}

        </div>
        <div class="swiper-progress-wrap">
          <div class="swiper-progress"></div>
        </div>
        <div class="swiper-buttons">
          <button class="swiper-prev">Prev</button>
          <button class="swiper-next">Next</button>
        </div>
      </div>

    </div>
  {% endblock %}

</div>
