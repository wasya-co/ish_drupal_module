{%
  set classes = [
    'SectionList10',
    content.field_class_name[0]['#context']['value'],

    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}

{# <h1>{{ dump( content.field_link_text ) }}</h1> #}

<div{{ attributes.addClass(classes) }} >

  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% block content %}
    <div class='container'>
      <div{{ content_attributes.addClass('content row') }}>

        <div class='col-12 col-lg-3'>
          <div class='container-1 _pushup-80px fade-up'>

            <h3>{{ content.field_subtitle }}</h3>
            <div class='float-left'>{{ content.field_image_thumb }}</div>
            {{ content.body }}

            {% if content.field_link_url[0]['#context']['value'] is not empty %}
              <a class='btn btn-primary'
                href="{{ content.field_link_url[0]['#context']['value'] }}"
              >{{ content.field_link_text[0]['#context']['value'] |default('read more') }}</a>
            {% endif %}

          </div>
        </div>
        <div class='col-12 col-lg-9'>
          <div class='container-2 fade-up'>

            {{ content.field_view_ref }}

          </div>
        </div>

      </div>
    </div>
  {% endblock %}
</div>
