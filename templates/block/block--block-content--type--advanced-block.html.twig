
{%
  set classes = [
    'AdvancedBlock',
    content.field_class_name[0]['#context']['value'],

    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}

{# <h1>{{ dump( content.field_class_name ) }}</h1> #}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    <div{{ content_attributes.addClass('content') }}>
      {{ content | without( 'field_class_name' ) }}
    </div>
  {% endblock %}
</div>
