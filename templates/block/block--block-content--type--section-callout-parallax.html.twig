
<style>
  {{ content.field_custom_css[0]['#context']['value'] }}
</style>

{%
  set classes = [
    'SectionCalloutParallax',
    content.field_class_name[0]['#context']['value'],

    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}

{# <h1>{{ dump( content.field_custom_css[0]['#context']['value'] ) }}</h1> #}

<div{{ attributes.addClass(classes) }} style="background-image: url({{ content.field_image_hero[0]['#markup'] }} )" >
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% block content %}
    <div{{ content_attributes.addClass('content') }}>
      {# {{ content | without('field_class_name', 'field_image_bg', 'field_image_thumb', 'field_link_text', 'field_link_url', 'field_title' ) }} #}
      <h3>{{ content.field_subtitle }}</h3>

      {{ content.body }}

      {# {{ dump( content ) }} #}
    </div>
  {% endblock %}
</div>
