
{% include '@ish_drupal_module/threejs_importmap.html.twig' %}

<div class='content'>
  <div class='row'>

    <div class='col-sm-12 col-md-6'>

      <div
        class='rotatingC'
        data-model-url="{{ content.field_icon|render|striptags|trim|e('html_attr') }}"
        style="width:100%;aspect-ratio:1;min-height:240px;"
      ></div>

    </div>
    <div class='col-sm-12 col-md-6'>
      <div class='container-2 fade-up'>

        {{ content.body }}
        {% if content.field_link_url[0]['#context']['value'] %}
          <a class='btn btn-primary'
            href="{{ content.field_link_url[0]['#context']['value'] }}"
          >{{ content.field_link_text[0]['#context']['value'] }}</a>
        {% endif %}

      </div>
    </div>

  </div>
</div>

<script type='module'>
import * as THREE from 'three'
import { OrbitControls } from 'three/addons/controls/OrbitControls.js'
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js'

function init_rotating_c(container) {
  const model_url = container.dataset.modelUrl
  if (!model_url) {
    return
  }

  const width = container.clientWidth || 280
  const height = container.clientHeight || width

  const scene = new THREE.Scene()

  const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 100)
  camera.position.z = 2.8

  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true })
  renderer.setClearColor(0x000000, 0)
  renderer.setSize(width, height)
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))
  container.appendChild(renderer.domElement)

  const controls = new OrbitControls(camera, renderer.domElement)
  controls.enableDamping = true
  controls.dampingFactor = 0.08
  controls.target.set(0, 0, 0)

  scene.add(new THREE.AmbientLight(0xffffff, 0.55))
  const key_light = new THREE.DirectionalLight(0xffffff, 0.85)
  key_light.position.set(2, 4, 3)
  scene.add(key_light)

  const loader = new GLTFLoader()
  loader.load(
    model_url,
    (gltf) => {
      const model = gltf.scene
      const box = new THREE.Box3().setFromObject(model)
      const center = box.getCenter(new THREE.Vector3())
      const size = box.getSize(new THREE.Vector3())
      model.position.sub(center)
      const max_dim = Math.max(size.x, size.y, size.z)
      if (max_dim > 0) {
        model.scale.setScalar(1.8 / max_dim)
      }
      scene.add(model)
    },
    undefined,
    (err) => {
      console.error('GLB load failed', model_url, err)
    }
  )

  function resize() {
    const w = container.clientWidth || 280
    const h = container.clientHeight || w
    camera.aspect = w / h
    camera.updateProjectionMatrix()
    renderer.setSize(w, h)
  }

  function tick() {
    requestAnimationFrame(tick)
    controls.update()
    renderer.render(scene, camera)
  }

  window.addEventListener('resize', resize)
  tick()
}

document.querySelectorAll('.rotatingC').forEach(init_rotating_c)
</script>
