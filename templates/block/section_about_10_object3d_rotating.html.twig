
{{ attach_library('ish_drupal_module/threejs') }}

<div class='content'>
  <div class='row'>

    <div class='col-sm-12 col-md-6'>

      {{ content.field_icon }}

    </div>
    <div class='col-sm-12 col-md-6'>
      <div class='container-2 fade-up'>

        {{ content.body }}
        {% if content.field_link_url[0]['#context']['value'] %}
          <a class='btn btn-primary'
            href="{{ content.field_link_url[0]['#context']['value'] }}"
          >{{ content.field_link_text[0]['#context']['value'] }}</a>
        {% endif %}

      </div>
    </div>

  </div>
</div>
