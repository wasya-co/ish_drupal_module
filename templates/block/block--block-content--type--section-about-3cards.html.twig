
<section class="SectionAbout3cards home1-whychoose-block ">
  <div class="container">

      <div class="row d-flex align-items-center">
        <div class="col-md-6">
          <div class="content-wrapper" data-aos="fade-up">
            <span class="mini-title">{{ content.field_tagline }}</span>
            <h2 class="left-title">{{ content.field_subtitle }}</h2>
            {{ content.body }}
