
{%
  set classes = [
    'SectionHeroVideo',

    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% if 'On' == content.field_autoplay[0]['#markup'] %}
    <video class="hero-video" autoplay="" muted="" loop="" playsinline="" preload="metadata">
      <source src="{{ file_url( content.field_video_file['#items'].entity.uri.value ) }}" type="video/mp4">
    </video>
  {% endif %}

  <div class='overlay'></div>
  <div class='hero-image' style="background-image: url({{ file_url( content.field_image_hero['#items'].entity.uri.value ) }})" alt='' ></div>

  {% block content %}
    <div{{ content_attributes.addClass('content') }}>
      {{ content | without('field_autoplay') | without('field_image_hero') | without('field_video_file') }}

        {# <ul>
          <li>{{ file_url( content.field_video_file['#items'].entity.uri.value ) }}</li>
          <li>{{ content.field_video_file }}</li>
          <li>{{ content.field_image_hero }}</li>
          <li>{{ content.field_autoplay[0]['#markup'] }}</li>
          <li>{{ dump( content.field_autoplay[0] ) }}</li>
        </ul> #}

    </div>
  {% endblock %}
</div>

