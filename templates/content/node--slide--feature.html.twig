

{% set image_hero = node.field_image_hero.entity %}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
<article{{ attributes.addClass(classes) }}>

  {% if image_hero %}
    <div class='image-hero' style="background-image: url({{ file_url(image_hero.uri.value) }});" ></div>
  {% endif %}

  {# {{ dump( content.field_is_reverse['#items'].value   ) }} #}

  <div{{ content_attributes.addClass('maxwidth node__content row').addClass(content.field_is_reverse['#items'].value == '1' ? 'flex-row-reverse' : '') }}>
    <div class='col-md-6'>
      <a href="{{ content.field_link_url[0]['#context']['value'] }}">
        {{ content.field_image_thumb }}
      </a>
    </div>
    <div class='col-md-6'>
      {{ title_prefix }}
      {% if label and not page %}
        <h2{{ title_attributes }}>
          <a href="{{ content.field_link_url[0]['#context']['value'] }}" rel="bookmark">{{ label }}</a>
        </h2>
      {% endif %}
      {{ title_suffix }}

      {{ content.field_subtitle }}
      <a class='btn btn-primary'
         href="{{ content.field_link_url[0]['#context']['value'] }}">{{ content.field_link_text }}
      </a>

      {# {{ content | without('field_image_thumb') }} #}
    </div>
  </div>

  <div class="clearfix"></div>

</article>
