
{#
 # two-col. left: half-Card for the image_thumb
 # right: title, body, links
##}

{%
  set classes = [
    'container',

    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}

{# {{ dump( content ) }} #}

<article{{ attributes.addClass(classes) }}>

  <div class='row'>

    <div class='col-12 col-md-6 order-md-2 second-col'>

      {{ title_prefix }}
      {% if label and not page %}
        <h2{{ title_attributes }}>
          <a href="{{ url }}" rel="bookmark">{{ label }}</a>
        </h2>
      {% endif %}
      {{ title_suffix }}

      {{ content.body }}

      <a class='btn btn-primary'
         href="{{ content.field_link_url[0]['#context']['value'] }}"
      >{{ content.field_link_text[0]['#context']['value'] }}</a>

    </div>
    <div class='col-12 col-md-6 order-md-1 first-col'>

      <div class='Card card-folder'>
        <div class='card-top-illu'>
          {% if node.field_image_thumb.entity %}
            <img src="{{ file_url(node.field_image_thumb.entity.uri.value) }}" alt="{{ node.field_image_thumb.alt|default('') }}" />
          {% endif %}
        </div>
      </div>

    </div>
  </div>

  <div class="clearfix"></div>

</article>
