<style>
  {{ settings.field_custom_css }}
</style>

{# {{ dump( settings ) }} #}

{% if content %}
  <div {{ attributes.addClass([ 'layout', 'layout--onecol' ]) }} >
    <div class='w-1'
      {% if settings.field_image_hero %} style="background-image: url('{{ settings.field_image_hero }}')" {% endif %}
    ><div class='{{ settings.field_class_name }}' >

      {% if content.first %}
        <div {{ region_attributes.first.addClass(settings.field_col1_class_name) }}>
          {{ content.first }}
        </div>
      {% endif %}

    </div></div>
  </div>
{% endif %}


