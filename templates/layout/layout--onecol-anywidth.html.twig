<style>
  {{ settings.field_custom_css }}
</style>
{% set classes = [
    'layout',
    'layout--onecol',
    settings.field_class_name,
] %}
{% if content %}
  <div class='w-1'
    {% if settings.field_image_hero %} style="background-image: url('{{ settings.field_image_hero }}')" >{% endif %}
  </div>
    <div {{ attributes.addClass(classes) }} >
      <div class='row'>

        {% if content.first %}
          <div {{ region_attributes.first.addClass(settings.field_col1_class_name) }}>
            {{ content.first }}
          </div>
        {% endif %}

      </div>
    </div>
  </div>
{% endif %}


