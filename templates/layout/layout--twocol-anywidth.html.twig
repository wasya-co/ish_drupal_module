{%
  set classes = [
    'layout',
    'layout--twocol',
    settings.field_class_name,
  ]
%}
{% if content %}
  <div {{ attributes.addClass(classes) }}
       {% if settings.field_image_hero %} style="background-image: url('{{ settings.field_image_hero }}')"{% endif %}
  >
    <div class='row'>

      {% if content.first %}
        <div {{ region_attributes.first.addClass(settings.field_col1_class_name) }}>
          {{ content.first }}
        </div>
      {% endif %}

      {% if content.second %}
        <div {{ region_attributes.second.addClass(settings.field_col2_class_name) }}>
          {{ content.second }}
        </div>
      {% endif %}

    </div>
  </div>
{% endif %}


