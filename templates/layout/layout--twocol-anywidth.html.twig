{%
  set classes = [
    'layout',
    'container',
    'layout--twocol',
    settings.extra_classes,
  ]
%}
{% if content %}
  <div{{ attributes.addClass(classes) }}>
    <div class='row'>

      {% if content.first %}
        <div {{ region_attributes.first.addClass(settings.col1_classes) }}>
          {{ content.first }}
        </div>
      {% endif %}

      {% if content.second %}
        <div {{ region_attributes.second.addClass(settings.col2_classes) }}>
          {{ content.second }}
        </div>
      {% endif %}

    </div>
  </div>
{% endif %}


