/*
 * trash so far!
**/
class IssueConfig {

  /*
   * set layout
   * trash, this is in content_types setup.
  **/
  public static function _TRASH_configure_layout() {
    $display = EntityViewDisplay::load('node.issue.full');

    if (!$display) {
      $display = EntityViewDisplay::create([
        'targetEntityType' => 'node',
        'bundle' => 'issue',
        'mode' => 'full',
        'status' => TRUE,
      ]);
    }

    $display->setThirdPartySetting('layout_builder', 'enabled', TRUE);
    $display->setThirdPartySetting('layout_builder', 'allow_custom', TRUE);
    $display->save();
  }


}
