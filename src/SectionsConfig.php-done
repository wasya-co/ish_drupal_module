

    if (!FieldStorageConfig::loadByName('block_content', 'field_video_file')) {
      FieldStorageConfig::create([
        'field_name' => 'field_video_file',
        'entity_type' => 'block_content',
        'type' => 'file',
        'cardinality' => 1,
        'settings' => [
          'target_type' => 'file',
          'uri_scheme' => 'public',
        ],
      ])->save();
    }
    if (!FieldConfig::loadByName('block_content', $section_name, 'field_video_file')) {
      FieldConfig::create([
        'field_name' => 'field_video_file',
        'entity_type' => 'block_content',
        'bundle' => $section_name,
        'label' => 'field_video_file',
        'required' => FALSE,
        'settings' => [
          'file_extensions' => 'mp4 webm ogv',
          'description_field' => FALSE,
        ],
      ])->save();
    }
    $form_display->setComponent('field_video_file', [
      'type' => 'file_generic',
      'weight' => 10,
    ])->save();
    $display->setComponent('field_video_file', [
      'label' => 'hidden',
      'type' => 'file_url_plain',
      'weight' => 10,
    ])->save();


    if (!FieldStorageConfig::loadByName('block_content', 'field_autoplay')) {
      FieldStorageConfig::create([
        'field_name' => 'field_autoplay',
        'entity_type' => 'block_content',
        'type' => 'boolean',
        'cardinality' => 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('block_content', $section_name, 'field_autoplay')) {
      FieldConfig::create([
        'field_name' => 'field_autoplay',
        'entity_type' => 'block_content',
        'bundle' => $section_name,
        'label' => 'Autoplay',
        'required' => FALSE,
        'default_value' => $field_c['default_value'] ?? [],
      ])->save();
    }
    $form_display->setComponent('field_autoplay', [
      'type' => 'boolean_checkbox',
      'weight' => 10,
    ]);
    $display->setComponent('field_autoplay', [
      'label' => 'hidden',
      'type' => 'boolean',
      'weight' => 10,
    ])->save();


    if (!FieldStorageConfig::loadByName('block_content', 'field_image')) {
      FieldStorageConfig::create([
        'field_name' => 'field_image',
        'entity_type' => 'block_content',
        'type' => 'file',
        'cardinality' => 1,
        'settings' => [
          'target_type' => 'file',
          'uri_scheme' => 'public',
        ],
      ])->save();
    }
    if (!FieldConfig::loadByName('block_content', $section_name, 'field_image')) {
      FieldConfig::create([
        'field_name' => 'field_image',
        'entity_type' => 'block_content',
        'bundle' => $section_name,
        'label' => 'field_image',
        'required' => FALSE,
        'settings' => [
          'file_extensions' => 'jpg jpeg png gif',
          'description_field' => FALSE,
        ],
      ])->save();
    }
    $form_display->setComponent('field_image', [
      'type' => 'file_generic',
      'weight' => 10,
    ])->save();
    $display->setComponent('field_image', [
      'label' => 'hidden',
      'type' => 'file_url_plain',
      'weight' => 10,
    ])->save();
